  <bpmn:process id="hospital-booking" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Booking requested">
      <bpmn:outgoing>Flow_1i4eu3x</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1i4eu3x" sourceRef="StartEvent_1" targetRef="Activity_1ocfmvw" />
    <bpmn:businessRuleTask id="Activity_1ocfmvw" name="Check slot">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="slot_decision" resultVariable="slotResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1i4eu3x</bpmn:incoming>
      <bpmn:outgoing>Flow_0rg1sj2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_18izubm">
      <bpmn:incoming>Flow_0rg1sj2</bpmn:incoming>
      <bpmn:outgoing>Flow_13syux6</bpmn:outgoing>
      <bpmn:outgoing>Flow_1bbqjnl</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0rg1sj2" sourceRef="Activity_1ocfmvw" targetRef="Gateway_18izubm" />
    <bpmn:task id="Activity_0mcpt1w" name="Book Slot">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_13syux6</bpmn:incoming>
      <bpmn:outgoing>Flow_0800wik</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_13syux6" name="Available" sourceRef="Gateway_18izubm" targetRef="Activity_0mcpt1w">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotResult.slotStatus = "available"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0800wik" sourceRef="Activity_0mcpt1w" targetRef="Activity_0c4pr3w" />
    <bpmn:endEvent id="Event_1cmk5yi">
      <bpmn:incoming>Flow_1o5p14c</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1o5p14c" sourceRef="Activity_0c4pr3w" targetRef="Event_1cmk5yi" />
    <bpmn:sequenceFlow id="Flow_1bbqjnl" name="Full" sourceRef="Gateway_18izubm" targetRef="Activity_0np5wln">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotResult.slotStatus = "false"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0xxp19q">
      <bpmn:incoming>Flow_1xp57e8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1xp57e8" sourceRef="Activity_0np5wln" targetRef="Event_0xxp19q" />
    <bpmn:callActivity id="Activity_0c4pr3w" name="Send confirmation">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0800wik</bpmn:incoming>
      <bpmn:outgoing>Flow_1o5p14c</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Activity_0np5wln" name="Call Activity: Send slot-full notice">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1bbqjnl</bpmn:incoming>
      <bpmn:outgoing>Flow_1xp57e8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:subProcess id="Activity_1dzkole" name="Handle cancellation" triggeredByEvent="true">
      <bpmn:startEvent id="Event_1iqm5j9" name="Cancellation requested">
        <bpmn:outgoing>Flow_05z7exh</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1dihqw0" messageRef="Message_143km6t" />
      </bpmn:startEvent>
      <bpmn:task id="Activity_1y9t97o" name="Release slot">
        <bpmn:incoming>Flow_05z7exh</bpmn:incoming>
        <bpmn:outgoing>Flow_0bnw5ge</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Flow_05z7exh" sourceRef="Event_1iqm5j9" targetRef="Activity_1y9t97o" />
      <bpmn:callActivity id="Activity_0f6taqe" name="Send cancellation notification">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" />
          <zeebe:ioMapping>
            <zeebe:input source="=recipientId" target="recipientId" />
            <zeebe:input source="=&#34;Your appointment has been cancelled.&#34;" target="messageText" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0bnw5ge</bpmn:incoming>
        <bpmn:outgoing>Flow_05mmxzw</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Flow_0bnw5ge" sourceRef="Activity_1y9t97o" targetRef="Activity_0f6taqe" />
      <bpmn:endEvent id="Event_0yzgjem">
        <bpmn:incoming>Flow_05mmxzw</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_05mmxzw" sourceRef="Activity_0f6taqe" targetRef="Event_0yzgjem" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:message id="Message_143km6t" name="CancelAppointment">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=CancelAppointment" />
    </bpmn:extensionElements>
  </bpmn:message>
